# =====================================================================================================
# TEST / UAT environment (staging deployment, BIR EIS sandbox testing).
# Use a SEPARATE Supabase project from production so test invoices never mix with real ones.
# In Vercel: Project → Settings → Environment Variables → "Preview" environment.
# =====================================================================================================

NEXT_PUBLIC_APP_ENV=test
NEXT_PUBLIC_APP_URL=https://test-einvoicing.vercel.app
NEXT_PUBLIC_PORTAL_NAME=SME e-Invoicing (TEST)
NEXT_PUBLIC_SOFTWARE_NAME=SME e-Invoicing
NEXT_PUBLIC_SOFTWARE_VERSION=1.0.0
NEXT_PUBLIC_PROVIDER_NAME=Your Company Inc.
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=

# Supabase TEST project
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test_xxx
SUPABASE_SECRET_KEY=sb_secret_test_xxx

# Use `mock` for everyday testing. Switch to `bir` while running BIR's EIS certification (sandbox) tests;
# the sandbox credentials are entered in the app under Compliance > EIS Transmissions.
EIS_PROVIDER=mock
# openssl rand -base64 32 (encrypts saved EIS credentials)
EIS_CREDENTIALS_KEY=
EIS_TIMEOUT_MS=30000

CRON_SECRET=replace-with-a-random-test-secret

PASSWORD_MAX_AGE_DAYS=30
