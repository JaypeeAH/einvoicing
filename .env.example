# =====================================================================================================
# Environment variables — copy to `.env.local` for local development.
# Separate templates exist for each deployment: .env.test.example (UAT / BIR sandbox) and
# .env.production.example. Never commit real values (.gitignore excludes every .env file except these).
#
# NEXT_PUBLIC_* values are sent to the browser. Everything else stays on the server.
# =====================================================================================================

# --- App -------------------------------------------------------------------------------------------
# `test` shows a "TEST ENVIRONMENT" banner on every page; use `production` only for the live system.
NEXT_PUBLIC_APP_ENV=test
# Public URL of this deployment (used in invitation and password-reset email links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_NAME=SME e-Invoicing
# Must match the system name/version declared in each taxpayer's CAS registration (sworn statement).
# Changing the version after registration requires notifying the RDO (RMC 5-2021).
NEXT_PUBLIC_SOFTWARE_NAME=SME e-Invoicing
NEXT_PUBLIC_SOFTWARE_VERSION=1.0.0
# Your company (the system provider that co-signs the taxpayer's Joint Sworn Statement).
NEXT_PUBLIC_PROVIDER_NAME=Your Company Inc.
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=

# --- Supabase --------------------------------------------------------------------------------------
# Project Settings → API (Data API) in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…) or the legacy anon key. Safe in the browser: RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_…) or the legacy service_role key. SERVER ONLY — it bypasses row-level
# security. Used to invite users and by the scheduled EIS transmission job.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- BIR EIS (Electronic Invoicing System) ---------------------------------------------------------
# `mock` simulates BIR (nothing leaves the app). `bir` sends to the BIR EIS using the credentials BIR
# issues to the taxpayer during EIS certification (eis-cert.bir.gov.ph).
EIS_PROVIDER=mock
EIS_BASE_URL=
EIS_APPLICATION_ID=
EIS_APPLICATION_SECRET=
# PEM private key used to sign payloads (JWS). Put on one line with \n for line breaks.
EIS_SIGNING_PRIVATE_KEY=
EIS_TIMEOUT_MS=30000

# --- Scheduled jobs --------------------------------------------------------------------------------
# Shared secret for GET /api/cron/transmissions (send header `Authorization: Bearer <CRON_SECRET>`).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Security --------------------------------------------------------------------------------------
# Days before users must change their password (CAS standard, RMC 5-2021 Annex B: 30). 0 disables.
PASSWORD_MAX_AGE_DAYS=30
