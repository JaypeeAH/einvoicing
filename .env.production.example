# =====================================================================================================
# PRODUCTION environment (live invoices).
# In Vercel: Project → Settings → Environment Variables → "Production" environment.
# Store secrets only in your hosting provider's secret store — never in the repository.
# =====================================================================================================

NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://einvoicing.example.com
NEXT_PUBLIC_PORTAL_NAME=SME e-Invoicing
# Must match what taxpayers declared in their CAS registration; bump only with an RDO notice.
NEXT_PUBLIC_SOFTWARE_NAME=SME e-Invoicing
NEXT_PUBLIC_SOFTWARE_VERSION=1.0.0
NEXT_PUBLIC_PROVIDER_NAME=Your Company Inc.
NEXT_PUBLIC_TERMS_URL=https://example.com/terms
NEXT_PUBLIC_PRIVACY_URL=https://example.com/privacy

# Supabase PRODUCTION project (enable Point-in-Time Recovery / daily backups)
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_prod_xxx
SUPABASE_SECRET_KEY=sb_secret_prod_xxx

# `bir` once the taxpayer holds a Permit to Transmit and EIS certification. Until then keep `mock`
# and leave EIS transmission turned off in Company settings.
EIS_PROVIDER=bir
EIS_BASE_URL=
EIS_APPLICATION_ID=
EIS_APPLICATION_SECRET=
EIS_SIGNING_PRIVATE_KEY=
EIS_TIMEOUT_MS=30000

CRON_SECRET=replace-with-a-long-random-secret

PASSWORD_MAX_AGE_DAYS=30
